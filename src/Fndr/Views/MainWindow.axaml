<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Fndr.ViewModels"
        xmlns:s="using:Fndr.Services"
        x:Class="Fndr.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="fndr" Width="960" Height="600"
        FontFamily="Maple Mono NF,Consolas"
        Background="#202124">
  <Window.Styles>
    <Style Selector="Button.place, Button.topnav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.place:pointerover, Button.topnav:pointerover">
      <Setter Property="Background" Value="#3b4045" />
    </Style>
    <Style Selector="Button.place">
      <Setter Property="Foreground" Value="#e8eaed" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="Button.topnav">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="16" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0" Background="#26282b" Padding="8,12">
      <StackPanel Spacing="2">
        <TextBlock Text="Места" Foreground="#e8eaed" FontWeight="Bold" Margin="12,4,0,8" Opacity="0.6" />
        <ItemsControl ItemsSource="{Binding Places}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Place">
              <Button Classes="place" Content="{Binding Title}" Click="OnPlace" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Background="#2b2f34" Padding="8,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Classes="topnav" Content="‹" Click="OnBack" />
            <Button Classes="topnav" Content="↑" Click="OnUp" />
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding Path, Mode=OneWay}" KeyDown="OnPathKey"
                   Background="#3b4045" Foreground="White" CaretBrush="White"
                   BorderThickness="0" CornerRadius="6" Padding="10,6" Margin="8,0" />
          <CheckBox Grid.Column="2" Content="скрытые"
                    Foreground="White"
                    IsChecked="{Binding ShowHidden}" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <TextBox x:Name="SearchBox" DockPanel.Dock="Top" IsVisible="{Binding IsSearchVisible}"
               Text="{Binding Filter}" PlaceholderText="поиск в папке" KeyDown="OnSearchKey"
               Background="#3b4045" Foreground="White" CaretBrush="White"
               BorderThickness="0" CornerRadius="6" Padding="10,6" Margin="8,6" />
      <Border DockPanel.Dock="Bottom" Background="#2b2f34" BorderBrush="#3b4045" BorderThickness="0,1,0,0" Padding="12,4">
        <Grid ColumnDefinitions="*,Auto">
          <Grid.Styles>
            <Style Selector="TextBlock">
              <Setter Property="Foreground" Value="White" />
              <Setter Property="Opacity" Value="0.6" />
              <Setter Property="FontSize" Value="12" />
            </Style>
          </Grid.Styles>
          <TextBlock Text="{Binding Status}" />
          <TextBlock Grid.Column="1" Text="{Binding Selection}" />
        </Grid>
      </Border>
      <ListBox x:Name="List" ItemsSource="{Binding Entries}" SelectionMode="Multiple" Background="#202124"
               DoubleTapped="OnOpen" KeyDown="OnListKey" SelectionChanged="OnSelectionChanged">
        <ListBox.Styles>
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /></Style>
          <Style Selector="ListBoxItem TextBlock">
            <Setter Property="Foreground" Value="#e8eaed" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="TextBlock.meta">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="s:Entry">
            <Grid ColumnDefinitions="Auto,*,90,150" Margin="12,3">
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Emoji,Apple Color Emoji" Width="18" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Classes="meta" Text="{Binding SizeText}" />
              <TextBlock Grid.Column="3" Classes="meta" Text="{Binding ModifiedText}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</Window>
